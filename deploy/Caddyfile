# Caddy als Reverse-Proxy mit automatischem HTTPS (Let's Encrypt) für propweather.org.
# Installation: siehe DEPLOY.md  ->  /etc/caddy/Caddyfile

propweather.org {
	encode zstd gzip

	header {
		# Browser nur noch per HTTPS verbinden lassen (1 Jahr)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy 127.0.0.1:3000
}

# www.propweather.org auf die Hauptadresse umleiten.
# Setzt einen DNS-Eintrag für "www" voraus – sonst diesen Block löschen.
www.propweather.org {
	redir https://propweather.org{uri} permanent
}
