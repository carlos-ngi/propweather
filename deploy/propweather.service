# systemd-Dienst für PropWeather
# Installation: siehe DEPLOY.md
#   sudo cp deploy/propweather.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now propweather

[Unit]
Description=PropWeather – solar-terrestrial data
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=propweather
Group=propweather
WorkingDirectory=/opt/propweather
ExecStart=/usr/bin/node /opt/propweather/server.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
# Nur mit Reverse-Proxy (Caddy oder cloudflared) davor:
Environment=TRUST_PROXY=1
Restart=on-failure
RestartSec=5

# --- Härtung: der Dienst darf praktisch nichts ausser Netzwerk und Lesen seiner Dateien ---
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Verbotene Aufrufe mit «nicht erlaubt» beantworten statt den Prozess zu beenden:
# Node.js probiert beim Start neuere Kernel-Funktionen (z. B. io_uring) und weicht
# bei einer Fehlermeldung selbst auf ältere aus. Ohne diese Zeile: Abbruch mit 31/SYS.
SystemCallErrorNumber=EPERM
UMask=0077
# Hinweis: MemoryDenyWriteExecute darf bei Node.js NICHT gesetzt werden (JIT-Compiler).

# --- Ressourcen begrenzen ---
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
